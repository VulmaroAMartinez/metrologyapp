# Plantilla de configuración. Uso: cp .env.example .env && make up
# TODOS los valores de este archivo son DE EJEMPLO. Cámbialos antes de usar
# el sistema con datos reales. .env está en .gitignore; nunca lo subas al repo.
# El compose vive en deploy/, por eso make usa --env-file .env de forma explícita.

# --- Base de datos -----------------------------------------------------------
# Nombre de la base de datos.
DB_NAME=metrologia
# Superusuario de PostgreSQL ('postgres'). Solo lo usa la inicialización y el
# healthcheck del contenedor; la aplicación nunca se conecta con él.
POSTGRES_PASSWORD=EJEMPLO-cambia-superusuario
# Rol 'migrator': dueño del esquema. Solo para migraciones y pruebas (puede crear BD de prueba).
MIGRATOR_PASSWORD=EJEMPLO-cambia-migrator
# Rol 'app': el que usa Django en ejecución. Sin privilegios de esquema.
APP_PASSWORD=EJEMPLO-cambia-app

# --- Django ------------------------------------------------------------------
# Clave secreta de Django. Genera una: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=EJEMPLO-cambia-esta-clave-larga-y-aleatoria
# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cuántos proxies hay delante de Django (para obtener la IP real del cliente
# en X-Forwarded-For). Con Caddy como único punto de entrada: 1.
API_NUM_PROXIES=1
# Longitud mínima de contraseña (provisional: 10; ver docs/decisiones.md).
PASSWORD_MIN_LENGTH=10

# --- Proxy (Caddy) -----------------------------------------------------------
# Puerto del host donde se publica el sistema. Solo se enlaza a 127.0.0.1.
HTTP_PORT=8080
# Proxies de confianza DELANTE de Caddy (balanceador de la empresa), en CIDR separados
# por espacio. Vacío = Caddy es el borde y usa la IP del socket. Si lo rellenas, Caddy
# tomará la IP real del cliente de X-Forwarded-For solo cuando venga de estos rangos.
CADDY_TRUSTED_PROXIES=
