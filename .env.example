# Plantilla de configuración. Uso: cp .env.example .env && make up
# TODOS los valores de este archivo son DE EJEMPLO. Cámbialos antes de usar
# el sistema con datos reales. .env está en .gitignore; nunca lo subas al repo.
# El compose vive en deploy/, por eso make usa --env-file .env de forma explícita.

# --- Base de datos -----------------------------------------------------------
# Nombre de la base de datos.
DB_NAME=metrologia
# Superusuario de PostgreSQL ('postgres'). Solo lo usa la inicialización y el
# healthcheck del contenedor; la aplicación nunca se conecta con él.
POSTGRES_PASSWORD=EJEMPLO-cambia-superusuario
# Rol 'migrator': dueño del esquema. Solo para migraciones y pruebas (puede crear BD de prueba).
MIGRATOR_PASSWORD=EJEMPLO-cambia-migrator
# Rol 'app': el que usa Django en ejecución. Sin privilegios de esquema.
APP_PASSWORD=EJEMPLO-cambia-app

# --- Django ------------------------------------------------------------------
# Clave secreta de Django. Genera una: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=EJEMPLO-cambia-esta-clave-larga-y-aleatoria
# Hosts permitidos, separados por coma.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Cuántos proxies hay delante de Django (para obtener la IP real del cliente
# en X-Forwarded-For). Con Caddy como único punto de entrada: 1.
API_NUM_PROXIES=1
# Redes desde las que la API acepta X-Forwarded-For/Proto (el contenedor de Caddy). Fuera de
# ellas esas cabeceras se descartan. Sin definir, desarrollo usa los rangos privados (la lista vive
# solo en backend/config/settings/guards.py) y PRODUCCIÓN SE NEGARÁ A ARRANCAR. En producción,
# defínela con la subred de Docker de tu instalación: una red privada, no más ancha que /16
# (ver docs/guia-instalacion.md). Separadas por coma.
# TRUSTED_PROXY_CIDRS=172.28.0.0/24
# Longitud mínima de contraseña (provisional: 10; ver docs/decisiones.md).
PASSWORD_MIN_LENGTH=10
# Minutos de inactividad antes de cerrar la sesión (provisional: 30).
SESSION_IDLE_MINUTES=30
# Vida máxima de la sesión desde el inicio de sesión, aunque haya actividad (decisión: 12 horas).
SESSION_ABSOLUTE_HOURS=12
# Bloqueo de cuenta: intentos fallidos seguidos y minutos de bloqueo (provisional: 5 y 15).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Límite de intentos de inicio de sesión por minuto: por IP+correo y por IP sola.
LOGIN_RATE_PER_IP_EMAIL=5
LOGIN_RATE_PER_IP=20
# Orígenes extra de confianza para CSRF (separados por coma), p. ej. https://metrologia.empresa.com
CSRF_TRUSTED_ORIGINS=

# --- Proxy (Caddy) -----------------------------------------------------------
# Puerto del host donde se publica el sistema. Solo se enlaza a 127.0.0.1.
HTTP_PORT=8080
# Proxies de confianza DELANTE de Caddy (balanceador de la empresa), en CIDR separados
# por espacio. Vacío = Caddy es el borde y usa la IP del socket. Si lo rellenas, Caddy
# tomará la IP real del cliente de X-Forwarded-For solo cuando venga de estos rangos.
CADDY_TRUSTED_PROXIES=

# --- HTTPS en producción (HSTS) ---------------------------------------------
# Segundos que el navegador recordará usar solo HTTPS. Empieza corto (3600 = 1 hora) y súbelo por
# etapas cuando el HTTPS sea estable (ver docs/guia-instalacion.md). 0 desactiva la cabecera.
HSTS_SECONDS=3600
# true solo si TODOS los subdominios del dominio ya funcionan con HTTPS.
HSTS_INCLUDE_SUBDOMAINS=false
