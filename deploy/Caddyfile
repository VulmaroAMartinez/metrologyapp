{
	admin off
	auto_https off # dev en HTTP; producción define su propio bloque con TLS
	servers {
		# Solo se confía en X-Forwarded-For si viene de estos rangos (vacío = nadie).
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:}
	}
}

:8080 {
	header {
		X-Content-Type-Options nosniff
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy same-origin
		-Server
	}

	respond /healthz 200

	# Gancho para pruebas: `make test-proxy` monta aquí una ruta extra hacia una API en modo
	# producción. Sin archivos en esa carpeta no hace nada.
	import /etc/caddy/extra/*

	# Un solo origen: /api -> Django, el resto -> Next.js. Caddy fija
	# X-Forwarded-For con la IP del cliente (descarta el que mande el cliente).
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
